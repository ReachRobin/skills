---
import { marked } from 'marked'
import InstallSnippet from '../../components/InstallSnippet.astro'
import CompanionPanel from '../../components/CompanionPanel.astro'

type SkillData = {
  slug: string
  name: string
  description: string
  tier: 'core' | 'lab'
  category: 'strategy' | 'discovery' | 'outreach' | 'operations'
  rr_companion: 'none' | 'optional' | 'required'
  needs_mcp: string[]
  version: string
  maintainer: string
  body: string
  installSnippet: string
}

export async function getStaticPaths() {
  const rawModules = import.meta.glob('../../../../dist/site-data/*.json', { eager: true })
  const skills = Object.values(rawModules) as SkillData[]
  return skills
    .filter((s) => s.tier === 'lab')
    .map((skill) => ({
      params: { slug: skill.slug },
      props: { skill },
    }))
}

const { skill } = Astro.props as { skill: SkillData }
const pluginName = 'skills-lab'
const bodyHtml = marked.parse(skill.body)
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{skill.name} (Lab) - ReachRobin Skills</title>
    <meta name="description" content={skill.description} />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background: #f9fafb;
        color: #111827;
        margin: 0;
        line-height: 1.7;
      }
      .container {
        max-width: 760px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      .back-link {
        font-size: 0.82rem;
        color: #6b7280;
        text-decoration: none;
        display: inline-block;
        margin-bottom: 1.5rem;
      }
      .back-link:hover { color: #111827; }
      .skill-header {
        margin-bottom: 1.5rem;
      }
      .skill-header h1 {
        font-size: 1.6rem;
        font-weight: 700;
        margin: 0 0 0.5rem;
      }
      .badges {
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
        margin-bottom: 0.75rem;
      }
      .badge {
        font-size: 0.7rem;
        font-weight: 500;
        padding: 0.2rem 0.55rem;
        border-radius: 9999px;
        text-transform: capitalize;
      }
      .badge-lab {
        background: #f5f3ff;
        color: #7c3aed;
        border: 1px solid #ede9fe;
      }
      .badge-category {
        background: #f3f4f6;
        color: #6b7280;
        border: 1px solid #e5e7eb;
      }
      .lab-notice {
        font-size: 0.78rem;
        color: #8b5cf6;
        background: #f5f3ff;
        border: 1px solid #ede9fe;
        border-radius: 6px;
        padding: 0.4rem 0.75rem;
        margin-bottom: 1rem;
        display: inline-block;
      }
      .lede {
        font-size: 1rem;
        color: #374151;
        margin: 0;
        font-style: italic;
      }
      .divider {
        border: none;
        border-top: 1px solid #e5e7eb;
        margin: 1.75rem 0;
      }
      .skill-body {
        font-size: 0.9rem;
        color: #1f2937;
      }
      .skill-body h2 {
        font-size: 1.05rem;
        font-weight: 600;
        margin-top: 1.75rem;
        margin-bottom: 0.4rem;
      }
      .skill-body h3 {
        font-size: 0.95rem;
        font-weight: 600;
        margin-top: 1.25rem;
        margin-bottom: 0.25rem;
      }
      .skill-body p { margin: 0.5rem 0; }
      .skill-body ul, .skill-body ol {
        margin: 0.5rem 0;
        padding-left: 1.4rem;
      }
      .skill-body li { margin: 0.2rem 0; }
      .skill-body code {
        font-family: ui-monospace, Menlo, monospace;
        font-size: 0.82rem;
        background: #f3f4f6;
        padding: 0.1rem 0.3rem;
        border-radius: 3px;
      }
      .skill-body pre {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: 0.75rem 1rem;
        overflow-x: auto;
      }
      .skill-body pre code {
        background: none;
        padding: 0;
      }
      .section-heading {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #9ca3af;
        margin: 1.75rem 0 0.75rem;
      }
      .maintainer {
        margin-top: 2.5rem;
        padding-top: 1rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.8rem;
        color: #9ca3af;
      }
      .maintainer a { color: #6b7280; }
      footer {
        margin-top: 2rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.8rem;
        color: #9ca3af;
      }
      footer a { color: #6b7280; }
    </style>
  </head>
  <body>
    <div class="container">
      <a href="../../" class="back-link">← All skills</a>

      <div class="skill-header">
        <span class="lab-notice">Lab experiment - not battle-tested</span>
        <h1>{skill.name}</h1>
        <div class="badges">
          <span class="badge badge-lab">lab</span>
          <span class="badge badge-category">{skill.category}</span>
        </div>
        <p class="lede">{skill.description}</p>
      </div>

      <hr class="divider" />

      {skill.rr_companion !== 'none' && (
        <CompanionPanel rrCompanion={skill.rr_companion} />
      )}

      <div class="skill-body" set:html={bodyHtml} />

      <h2 class="section-heading">Install</h2>
      <InstallSnippet pluginName={pluginName} slug={skill.slug} />

      <div class="maintainer">
        Maintained by{' '}
        <a href={`https://github.com/${skill.maintainer}`} target="_blank" rel="noopener">
          @{skill.maintainer}
        </a>
        {' '}&middot; v{skill.version}
      </div>

      <footer>
        Built by ReachRobin. <a href="https://reachrobin.com/?utm_source=skills">What's RR?</a>
      </footer>
    </div>
  </body>
</html>

---
import SkillCard from '../components/SkillCard.astro'

// Load all built skill data files. Path is relative to the output dist directory.
// The cli build writes to dist/site-data/<slug>.json from repo root.
const rawModules = import.meta.glob('../../../dist/site-data/*.json', { eager: true })

type SkillData = {
  slug: string
  name: string
  description: string
  tier: 'core' | 'lab'
  category: 'strategy' | 'discovery' | 'outreach' | 'operations'
  rr_companion: 'none' | 'optional' | 'required'
  needs_mcp: string[]
  version: string
  maintainer: string
  body: string
  installSnippet: string
}

const skills = Object.values(rawModules) as SkillData[]
const coreSkills = skills.filter((s) => s.tier === 'core')
const labSkills = skills.filter((s) => s.tier === 'lab')

const CORE_CATEGORIES = ['strategy', 'discovery', 'outreach', 'operations'] as const
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>ReachRobin Skills</title>
    <meta
      name="description"
      content="Open-source GTM playbook as skills for Claude Code, ChatGPT, Cursor, and other LLM clients."
    />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #f9fafb;
        /* Faint warm echo of the brand mark's gold burst - barely there. */
        background-image: radial-gradient(60rem 26rem at 18% -10%, rgba(245, 180, 36, 0.07), transparent 70%);
        background-repeat: no-repeat;
        color: #111827;
        margin: 0;
        line-height: 1.6;
      }
      .container {
        max-width: 900px;
        margin: 0 auto;
        padding: 2rem 1.5rem;
      }
      header {
        margin-bottom: 2.5rem;
        border-bottom: 1px solid #e5e7eb;
        padding-bottom: 1.5rem;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 1rem;
      }
      .brand-mark {
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        filter: drop-shadow(0 2px 6px rgba(17, 24, 39, 0.12));
      }
      .brand-text {
        min-width: 0;
      }
      header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        margin: 0 0 0.4rem;
      }
      header p {
        font-size: 0.95rem;
        color: #6b7280;
        margin: 0;
      }
      .section {
        margin-bottom: 2.5rem;
      }
      .section-heading {
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #9ca3af;
        margin: 0 0 0.75rem;
      }
      .cards {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 0.75rem;
      }
      .empty-category {
        font-size: 0.85rem;
        color: #d1d5db;
        font-style: italic;
      }
      .lab-section {
        margin-top: 2.5rem;
        padding-top: 2rem;
        border-top: 1px dashed #e5e7eb;
      }
      .lab-heading {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.07em;
        color: #c4b5fd;
        margin: 0 0 0.25rem;
      }
      .lab-intro {
        font-size: 0.82rem;
        color: #9ca3af;
        margin: 0 0 0.75rem;
        font-style: italic;
      }
      .empty-state {
        background: #fff;
        border: 1px dashed #d1d5db;
        border-radius: 8px;
        padding: 2rem;
        text-align: center;
        color: #9ca3af;
        font-size: 0.9rem;
      }
      .empty-state code {
        font-family: ui-monospace, monospace;
        background: #f3f4f6;
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.85rem;
      }
      footer {
        margin-top: 3rem;
        padding-top: 1.5rem;
        border-top: 1px solid #e5e7eb;
        font-size: 0.8rem;
        color: #9ca3af;
      }
      footer a {
        color: #6b7280;
        transition: color 0.15s ease;
      }
      footer a:hover { color: #111827; }
    </style>
  </head>
  <body>
    <div class="container">
      <header>
        <div class="brand">
          <img src="/favicon.png" alt="ReachRobin" class="brand-mark" width="64" height="64" />
          <div class="brand-text">
            <h1>ReachRobin Skills</h1>
            <p>
              Open-source GTM playbook as skills for Claude Code, ChatGPT, Cursor, and other LLM
              clients.
            </p>
          </div>
        </div>
      </header>

      {
        skills.length === 0 ? (
          <div class="empty-state">
            No skills built yet. Run <code>pnpm build</code> from repo root first.
          </div>
        ) : (
          <>
            {CORE_CATEGORIES.map((cat) => {
              const catSkills = coreSkills.filter((s) => s.category === cat)
              return (
                <div class="section">
                  <h2 class="section-heading">
                    {cat.charAt(0).toUpperCase() + cat.slice(1)}
                  </h2>
                  {catSkills.length === 0 ? (
                    <p class="empty-category">None yet.</p>
                  ) : (
                    <div class="cards">
                      {catSkills.map((skill) => (
                        <SkillCard
                          slug={skill.slug}
                          name={skill.name}
                          description={skill.description}
                          category={skill.category}
                          tier={skill.tier}
                          maintainer={skill.maintainer}
                        />
                      ))}
                    </div>
                  )}
                </div>
              )
            })}

            {labSkills.length > 0 && (
              <div class="lab-section">
                <h2 class="lab-heading">Lab</h2>
                <p class="lab-intro">
                  Experiments and one-offs. Mostly for fun, occasionally for traction.
                </p>
                <div class="cards">
                  {labSkills.map((skill) => (
                    <SkillCard
                      slug={skill.slug}
                      name={skill.name}
                      description={skill.description}
                      category={skill.category}
                      tier={skill.tier}
                      maintainer={skill.maintainer}
                    />
                  ))}
                </div>
              </div>
            )}
          </>
        )
      }

      <footer>
        Built by ReachRobin. <a href="https://reachrobin.com/?utm_source=skills">What's RR?</a>
      </footer>
    </div>
  </body>
</html>
